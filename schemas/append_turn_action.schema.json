{
  "additionalProperties": false,
  "description": "Action variant for `notebook_ops=\"append_log\"` (not in spec \u00a77, a declared rules variant).\n\nThe notebook is a rolling log: the engine adds the note on a new line and drops the oldest\nlines when the cap would be exceeded, so agents never compute offsets, revisions or compactions.\nBlank text or \"null\" counts as no note.",
  "properties": {
    "schema_version": {
      "const": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "tick": {
      "minimum": 1,
      "title": "Tick",
      "type": "integer"
    },
    "move": {
      "enum": [
        "N",
        "E",
        "S",
        "W",
        "STAY"
      ],
      "title": "Move",
      "type": "string"
    },
    "notebook_append": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Notebook Append"
    },
    "radio": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Radio"
    }
  },
  "required": [
    "schema_version",
    "tick",
    "move",
    "notebook_append",
    "radio"
  ],
  "title": "AppendTurnAction",
  "type": "object"
}
